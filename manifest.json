{
  "manifest_version": 3,
  "name": "My Dual Subtitles",
  "version": "2.7.0",
  "description": "Lồng tiếng Việt cho video YouTube tiếng Anh, tiếng Trung, tiếng Hindi (Gemini miễn phí hoặc Google Dịch).",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://*.tts.speech.microsoft.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Lồng tiếng Việt" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}